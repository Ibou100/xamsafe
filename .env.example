# ====================================================================
# XamSafe — Variables d'Environnement (Exemple)
# ====================================================================
# Note éthique et sécurité :
# Aucun secret de production ne doit être commité dans le dépôt Git.
# Ne configurez jamais de clés d'API tierces côté client sans proxy serveur.

# Code d'accès à l'espace d'administration des contenus (par défaut pour le dev : XamSafeAdmin2026!)
VITE_ADMIN_PASSCODE=XamSafeAdmin2026!

# Optionnel : Proxy serveur IA pour analyse approfondie (si déployé)
# Par défaut, XamSafe fonctionne 100% hors-ligne avec son moteur heuristique local sans fuite de données.
VITE_ENABLE_REMOTE_AI=false
VITE_AI_ANALYZER_ENDPOINT=

# Port local de développement Vite (optionnel)
PORT=5173
